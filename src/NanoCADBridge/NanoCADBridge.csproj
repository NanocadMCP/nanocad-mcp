<Project Sdk="Microsoft.NET.Sdk">
  <!-- nanoCAD 26 loads managed plugins on .NET 6; its SDK HelloHost and
       HelloMultiCAD samples target this framework. Retarget only with host support. -->
  <PropertyGroup>
    <TargetFramework>net6.0-windows</TargetFramework><PlatformTarget>x64</PlatformTarget>
    <EnableDynamicLoading>true</EnableDynamicLoading><CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <Import Project="NanoCADBridge.Acceptance.targets" />
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
    <Reference Include="hostmgd" HintPath="$(NanoCadManagedDir)\hostmgd.dll" Private="false" />
    <Reference Include="hostdbmgd" HintPath="$(NanoCadManagedDir)\hostdbmgd.dll" Private="false" />
    <Reference Include="hostPointCloudsMgd" HintPath="$(NanoCadManagedDir)\hostPointCloudsMgd.dll" Private="false" />
    <Reference Include="mapimgd" HintPath="$(NanoCadManagedDir)\..\bin_nPlat\mapimgd.dll" Private="false" />
    <Reference Include="MapiBaseTypes" HintPath="$(NanoCadManagedDir)\..\bin_nPlat\MapiBaseTypes.dll" Private="false" />
    <Reference Include="MapiBaseTypes2" HintPath="$(NanoCadManagedDir)\..\bin_nPlat\MapiBaseTypes2.dll" Private="false" />
    <Reference Include="mapinet" HintPath="$(NanoCadManagedDir)\..\bin_nPlat\mapinet.dll" Private="false" />
    <ProjectReference Include="../NanoCAD.Ipc/NanoCAD.Ipc.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <NativeParameters412Output>$(MSBuildProjectDirectory)\..\..\artifacts\native-parameters412\$(Configuration)\NanoCAD.NativeParameters412.dll</NativeParameters412Output>
  </PropertyGroup>
  <ItemGroup>
    <NativeParameters412BuildInput Include="$(MSBuildProjectDirectory)\..\NanoCAD.NativeParameters\NativeParameters.cpp;$(MSBuildProjectDirectory)\..\NanoCAD.NativeParameters\generate-sdk-slice412.ps1;$(MSBuildProjectDirectory)\..\NanoCAD.NativeParameters\sdk-compat\**\*.h;$(MSBuildProjectDirectory)\..\..\scripts\build-native-parameters412.ps1;$(MSBuildProjectDirectory)\..\..\NCadSDK_260_EN_7355.4942.259\include\MAPI\**\*.h;$(MSBuildProjectDirectory)\..\..\NCadSDK_260_EN_7355.4942.259\lib-x64\mctyp.lib" />
  </ItemGroup>
  <Target Name="BuildNativeParameters412" BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(NativeParameters412BuildInput)"
          Outputs="$(NativeParameters412Output)">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-native-parameters412.ps1&quot; -Configuration $(Configuration)" />
  </Target>
  <ItemGroup>
    <None Include="$(NativeParameters412Output)" Link="NanoCAD.NativeParameters412.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <NativeModelHistory421Output>$(MSBuildProjectDirectory)\..\..\artifacts\native-model-history421\$(Configuration)\NanoCAD.NativeModelHistory421.dll</NativeModelHistory421Output>
  </PropertyGroup>
  <ItemGroup>
    <NativeModelHistory421BuildInput Include="$(MSBuildProjectDirectory)\..\NanoCAD.NativeModelHistory\NativeModelHistory421.cpp;$(MSBuildProjectDirectory)\..\NanoCAD.NativeModelHistory\NativeBodyTransparency445.cpp;$(MSBuildProjectDirectory)\..\NanoCAD.NativeParameters\generate-sdk-slice412.ps1;$(MSBuildProjectDirectory)\..\NanoCAD.NativeParameters\sdk-compat\**\*.h;$(MSBuildProjectDirectory)\..\..\scripts\build-native-model-history421.ps1;$(MSBuildProjectDirectory)\..\..\NCadSDK_260_EN_7355.4942.259\include\MAPI\**\*.h;$(MSBuildProjectDirectory)\..\..\NCadSDK_260_EN_7355.4942.259\lib-x64\mctyp.lib;$(MSBuildProjectDirectory)\..\..\NCadSDK_260_EN_7355.4942.259\lib-x64\mt.lib;$(MSBuildProjectDirectory)\..\..\NCadSDK_260_EN_7355.4942.259\include\nrxdbgate\**\*.h;$(MSBuildProjectDirectory)\..\..\NCadSDK_260_EN_7355.4942.259\lib-x64\nrxdbgate.lib" />
  </ItemGroup>
  <Target Name="BuildNativeModelHistory421" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildNativeParameters412"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(NativeModelHistory421BuildInput)"
          Outputs="$(NativeModelHistory421Output)">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-native-model-history421.ps1&quot; -Configuration $(Configuration)" />
  </Target>
  <ItemGroup>
    <None Include="$(NativeModelHistory421Output)" Link="NanoCAD.NativeModelHistory421.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
